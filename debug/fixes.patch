+/**
+ * A waitlist row is not a ticket. The Booking model requires a unique
+ * ticketCode/qrCodeData, so we store a marker that is deliberately NOT valid
+ * QR ticket JSON — a scanner cannot parse it, let alone check it in.
+ */
+function generateWaitlistMarker(ticketCode: string): string {
+  return `WAITLIST:${ticketCode}`;
+}
+
+/**
+ * Seed dates are relative to the run date, not hardcoded calendar dates.
+ * Hardcoded dates silently rot: once they slip into the past, every event is
+ * unbookable and uncancellable, and the sold-out/waitlist scenarios below
+ * cannot be exercised at all.
+ */
+function daysFromNow(days: number): Date {
+  const d = new Date();
+  d.setHours(12, 0, 0, 0);
+  d.setDate(d.getDate() + days);
+  return d;
+}
