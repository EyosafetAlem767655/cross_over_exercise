index 6401157..8af8272 100644
--- a/backend/src/lib/transfer.ts
+++ b/backend/src/lib/transfer.ts
@@ -127,3 +127,80 @@ export async function transferBooking(
 
   return newBooking;
 }
+
+/**
+ * Hands an existing booking to a new owner WITHOUT cancelling it.
+ *
+ * Use this for attendee-initiated transfers. Unlike transferBooking(), the
+ * booking row keeps its id, ticketCode and qrCodeData, and its status stays
+ * CONFIRMED. That matters for three reasons:
+ *
+ *   1. No CANCELLED row is left behind in the sender's booking list, so the
+ *      ticket genuinely disappears from their account instead of lingering
+ *      as a "Cancelled" card.
+ *   2. Capacity is untouched — the seat never leaves the event, it only
+ *      changes hands. No decrement/increment round trip to get wrong.
+ *   3. Nothing downstream that reacts to a booking becoming CANCELLED (refund
+ *      accounting, dashboard refund counts, waitlist auto-promotion) fires on
+ *      what is really just an ownership change. Reusing the cancel+create path
+ *      here would hand a waitlisted user a seat that was never freed.
+ *
+ * Callers are responsible for authorization (the caller owns the booking) and
+ * for resolving/validating the recipient before calling this.
+ *
+ * @param tx - Prisma transaction client (call within $transaction)
+ * @param bookingId - ID of the booking to hand over
+ * @param recipientId - User ID of the new owner
+ * @returns The same booking record, now owned by the recipient
+ */
+export async function transferOwnership(
+  tx: any,
+  bookingId: string,
+  recipientId: string
+) {
+  const booking = await tx.booking.findUnique({
+    where: { id: bookingId },
+  });
+
+  if (!booking) {
+    throw new Error("NOT_FOUND:Booking not found");
+  }
+
+  if (booking.status !== "CONFIRMED") {
+    throw new Error("INVALID_STATUS:Only confirmed bookings can be transferred");
+  }
+
+  if (booking.userId === recipientId) {
+    throw new Error("VALIDATION:Cannot transfer a ticket to yourself");
+  }
+
+  return tx.booking.update({
+    where: { id: booking.id },
+    data: { userId: recipientId },
+    include: {
+      event: {
+        select: {
+          id: true,
+          name: true,
+          date: true,
+          time: true,
+          venue: true,
+        },
+      },
+      seatTier: {
+        select: {
+          id: true,
+          name: true,
+          price: true,
+        },
+      },
+      user: {
+        select: {
+          id: true,
+          name: true,
+          email: true,
+        },
+      },
+    },
+  });
+}
