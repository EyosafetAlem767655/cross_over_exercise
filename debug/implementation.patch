diff --git a/backend/src/lib/waitlist.ts b/backend/src/lib/waitlist.ts
new file mode 100644
index 0000000..bf7be9e
--- /dev/null
+++ b/backend/src/lib/waitlist.ts
@@ -0,0 +1,132 @@
+import { generateTicketCode, generateQRData } from "./qr.js";
+import { incrementCapacity, hasRoomFor } from "./capacity.js";
+
+/**
+ * Waitlist queue mechanics.
+ *
+ * `WaitlistEntry.position` is a monotonic sequence number assigned once on join
+ * and never rewritten. The position a user SEES is their rank among the entries
+ * that are still queued, computed at read time. Keeping the stored value
+ * immutable means leaving the queue is a plain delete — no resequencing pass
+ * that could race with a concurrent promotion and hand two people the same seat.
+ */
+
+/** Next sequence number for an event's queue. */
+export async function nextPosition(tx: any, eventId: string): Promise<number> {
+  const last = await tx.waitlistEntry.findFirst({
+    where: { eventId },
+    orderBy: { position: "desc" },
+    select: { position: true },
+  });
+  return (last?.position ?? 0) + 1;
+}
+
+/**
+ * A user's 1-based rank in an event's queue, or null if they are not on it.
+ * Derived from how many still-queued entries sit ahead of them.
+ */
+export async function getPosition(
+  tx: any,
+  eventId: string,
+  userId: string
+): Promise<number | null> {
+  const entry = await tx.waitlistEntry.findUnique({
+    where: { eventId_userId: { eventId, userId } },
+    select: { position: true },
+  });
+
+  if (!entry) return null;
+
+  const ahead = await tx.waitlistEntry.count({
+    where: { eventId, position: { lt: entry.position } },
+  });
+
+  return ahead + 1;
+}
+
+/** Total number of people queued for an event. */
+export function waitlistSize(tx: any, eventId: string): Promise<number> {
+  return tx.waitlistEntry.count({ where: { eventId } });
+}
+
+/**
+ * Give the freed seat to the person at the front of the queue.
+ *
+ * Call this INSIDE the same transaction as the cancellation that freed the
+ * seat, so the seat and the new ticket commit together or not at all.
+ *
+ * Call it ONLY when a seat genuinely became available. A ticket transfer also
+ * ends one person's claim on a booking, but the seat never leaves the event —
+ * promoting there would oversell. That is why transferOwnership() in
+ * lib/transfer.ts does not touch this function, and why it does not set a
+ * booking to CANCELLED.
+ *
+ * @param seatTierId - the tier of the seat that was freed (null for general
+ *   admission). The promoted attendee takes that same seat.
+ * @returns the booking created for the promoted user, or null if the queue was
+ *   empty, the seat was already claimed, or the front-of-queue user cannot be
+ *   given a ticket (they already hold one).
+ */
+export async function promoteFromWaitlist(
+  tx: any,
+  eventId: string,
+  seatTierId?: string | null
+) {
+  if (!(await hasRoomFor(tx, eventId, seatTierId))) {
+    return null;
+  }
+
+  // Walk the queue front-to-back; skip anyone who already holds a ticket for
+  // this event rather than failing the whole cancellation on their account.
+  const queue = await tx.waitlistEntry.findMany({
+    where: { eventId },
+    orderBy: { position: "asc" },
+  });
+
+  for (const entry of queue) {
+    const existing = await tx.booking.findFirst({
+      where: { userId: entry.userId, eventId, status: "CONFIRMED" },
+      select: { id: true },
+    });
+
+    // Stale entry: they bought a ticket after joining the queue. Drop it and
+    // move on so the seat still reaches somebody.
+    if (existing) {
+      await tx.waitlistEntry.delete({ where: { id: entry.id } });
+      continue;
+    }
+
+    const tier = seatTierId
+      ? await tx.seatTier.findUnique({ where: { id: seatTierId } })
+      : null;
+    const event = await tx.event.findUnique({ where: { id: eventId } });
+    const price = tier ? tier.price : event.price;
+
+    await incrementCapacity(tx, eventId, seatTierId ?? null);
+
+    const ticketCode = generateTicketCode();
+    const booking = await tx.booking.create({
+      data: {
+        ticketCode,
+        qrCodeData: generateQRData(ticketCode),
+        userId: entry.userId,
+        eventId,
+        seatTierId: seatTierId ?? null,
+        pricePaid: price,
+        discountAmount: 0,
+        status: "CONFIRMED",
+      },
+      include: {
+        event: { select: { id: true, name: true, date: true, time: true, venue: true } },
+        seatTier: { select: { id: true, name: true, price: true } },
+        user: { select: { id: true, name: true, email: true } },
+      },
+    });
+
+    await tx.waitlistEntry.delete({ where: { id: entry.id } });
+
+    return booking;
+  }
+
+  return null;
+}
