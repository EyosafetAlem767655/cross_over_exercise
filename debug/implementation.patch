+
+/**
+ * Is this event sold out?
+ *
+ * An event with tiers is sold out only when EVERY tier is full — the
+ * event-level counter is not authoritative there, because tier capacities are
+ * what the purchase path actually checks (see routes/bookings.ts). An event
+ * without tiers is sold out when its own counter reaches capacity.
+ *
+ * This mirrors the rule the frontend applies in events/[id]/page.tsx so the
+ * "Join Waitlist" button and the API agree on what "sold out" means.
+ */
+export async function isEventSoldOut(tx: any, eventId: string): Promise<boolean> {
+  const event = await tx.event.findUnique({
+    where: { id: eventId },
+    include: { seatTiers: true },
+  });
+
+  if (!event) return false;
+
+  if (event.seatTiers.length > 0) {
+    return event.seatTiers.every((t: any) => t.soldCount >= t.capacity);
+  }
+
+  return event.soldCount >= event.capacity;
+}
+
+/**
+ * Does this event have room for one more booking in the given tier?
+ *
+ * Used by waitlist promotion, which claims a specific seat that was just freed
+ * rather than "any" seat: when a tiered booking is cancelled it is that tier
+ * that has room, and promoting into a different, still-full tier would oversell.
+ */
+export async function hasRoomFor(
+  tx: any,
+  eventId: string,
+  seatTierId?: string | null
+): Promise<boolean> {
+  if (seatTierId) {
+    const tier = await tx.seatTier.findUnique({ where: { id: seatTierId } });
+    return !!tier && tier.soldCount < tier.capacity;
+  }
+
+  const event = await tx.event.findUnique({ where: { id: eventId } });
+  return !!event && event.soldCount < event.capacity;
+}
