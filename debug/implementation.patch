+
+/// A place in the queue for a sold-out event.
+///
+/// Modelled separately from Booking rather than as a Booking status: Booking
+/// requires a unique ticketCode/qrCodeData, so a status-based waitlist forces
+/// every queue member to carry scannable ticket credentials for a ticket they
+/// do not hold. A dedicated table also gives a real uniqueness constraint
+/// against double-joining, which a status value cannot express.
+///
+/// `position` is a monotonic sequence number, not a rank. It is assigned once
+/// on join and never rewritten, so leaving the queue is a plain delete with no
+/// resequencing pass (and therefore no lost-update race between a departure and
+/// a concurrent promotion). The position shown to a user is their *rank* among
+/// remaining entries, derived at read time.
+model WaitlistEntry {
+  id        String   @id @default(cuid())
+  position  Int
+  createdAt DateTime @default(now())
+  updatedAt DateTime @updatedAt
+
+  userId  String
+  user    User   @relation(fields: [userId], references: [id])
+  eventId String
+  event   Event  @relation(fields: [eventId], references: [id])
+
+  @@unique([eventId, userId])
+  @@index([eventId, position])
+}
