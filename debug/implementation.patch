+/**
+ * Integration suite for Story 1 (ticket transfer) and Story 2 (event waitlist),
+ * plus regression tests for the defects found auditing the existing code.
+ *
+ * Run with the API server up:
+ *   Terminal 1: npm run dev
+ *   Terminal 2: npm test
+ *
+ * Deliberately dependency-free. The project ships no test runner, and adding
+ * one (vitest/jest + a transform config) is a bigger change to the repo than
+ * the features themselves. Node's assert plus fetch against the real HTTP API
+ * exercises the routes, the transaction boundaries and the DB together, which
+ * is where every bug in this codebase actually lives.
+ *
+ * Fixtures are created per-run with unique emails and torn down at the end, so
+ * the suite is re-runnable and leaves seed data untouched.
+ */
+import { PrismaClient } from "@prisma/client";
+import assert from "node:assert/strict";
+import { randomBytes } from "crypto";
+
+const API = process.env.API_URL ?? "http://localhost:4000";
+const CHECKIN_KEY = process.env.CHECKIN_API_KEY ?? "your-api-key-for-scanner-apps";
+const prisma = new PrismaClient();
+
+const RUN = randomBytes(4).toString("hex");
+const PASSWORD = "testpass123";
+
+let passed = 0;
+let failed = 0;
+const failures: string[] = [];
+
+async function test(name: string, fn: () => Promise<void>) {
+  try {
+    await fn();
+    passed++;
+    console.log(`  PASS  ${name}`);
+  } catch (err) {
+    failed++;
+    const msg = err instanceof Error ? err.message : String(err);
+    failures.push(`${name}\n        ${msg.split("\n").join("\n        ")}`);
+    console.log(`  FAIL  ${name}`);
+    console.log(`        ${msg.split("\n")[0]}`);
+  }
+}
+
+// --- helpers ---------------------------------------------------------------
+
+type Res = { status: number; body: any };
+
+async function api(
+  method: string,
+  path: string,
+  opts: { token?: string; body?: unknown; apiKey?: string } = {}
+): Promise<Res> {
+  const headers: Record<string, string> = { "Content-Type": "application/json" };
+  if (opts.token) headers.Authorization = `Bearer ${opts.token}`;
+  if (opts.apiKey) headers["x-api-key"] = opts.apiKey;
+
+  const res = await fetch(`${API}${path}`, {
+    method,
+    headers,
+    body: opts.body === undefined ? undefined : JSON.stringify(opts.body),
+  });
+  return { status: res.status, body: await res.json().catch(() => null) };
+}
+
+async function makeUser(label: string, role: "ATTENDEE" | "ORGANIZER" = "ATTENDEE") {
+  const email = `t-${RUN}-${label}@example.test`;
+  const res = await api("POST", "/api/auth/register", {
+    body: { email, password: PASSWORD, name: `Test ${label}` },
+  });
+  assert.equal(res.status, 201, `register ${label}: ${JSON.stringify(res.body)}`);
+
+  if (role === "ORGANIZER") {
+    await prisma.user.update({ where: { email }, data: { role: "ORGANIZER" } });
+    const login = await api("POST", "/api/auth/login", { body: { email, password: PASSWORD } });
+    return { id: res.body.data.user.id, email, token: login.body.data.token };
+  }
+  return { id: res.body.data.user.id, email, token: res.body.data.token };
+}
+
+/** A published future event owned by a throwaway organizer. */
+async function makeEvent(opts: { capacity: number; price?: number; tiers?: { name: string; price: number; capacity: number }[] }) {
+  const organizerId = (await prisma.user.findFirst({ where: { role: "ORGANIZER" } }))!.id;
+  const event = await prisma.event.create({
+    data: {
+      name: `Test Event ${RUN}-${randomBytes(2).toString("hex")}`,
+      description: "Fixture event for the integration suite.",
+      date: new Date(Date.now() + 60 * 24 * 3600 * 1000),
+      time: "19:00",
+      venue: "Test Venue",
+      category: "OTHER",
+      price: opts.price ?? 100,
+      capacity: opts.capacity,
+      status: "PUBLISHED",
+      refundPolicy: "FULL_REFUND",
+      serviceFeePercent: 0,
+      organizerId,
+    },
+  });
+
+  const tiers = [];
+  for (const t of opts.tiers ?? []) {
+    tiers.push(await prisma.seatTier.create({ data: { ...t, eventId: event.id } }));
+  }
+  return { event, tiers };
+}
+
+/** Purchase a ticket as the given user. */
+function buy(token: string, eventId: string, seatTierId?: string) {
+  return api("POST", "/api/bookings", { token, body: { eventId, seatTierId } });
+}
+
+const soldCount = async (eventId: string) =>
+  (await prisma.event.findUnique({ where: { id: eventId } }))!.soldCount;
+
+const tierSold = async (tierId: string) =>
+  (await prisma.seatTier.findUnique({ where: { id: tierId } }))!.soldCount;
+
+// --- suite -----------------------------------------------------------------
+
+async function main() {
+  const health = await fetch(`${API}/health`).catch(() => null);
+  if (!health?.ok) {
+    console.error(`\nCannot reach the API at ${API}. Start it with "npm run dev" first.\n`);
+    process.exit(1);
+  }
+
+  const alice = await makeUser("alice");
+  const bob = await makeUser("bob");
+  const carol = await makeUser("carol");
+  const dave = await makeUser("dave");
+
+  console.log("\nSTORY 1 — Ticket transfer\n");
+
+  await test("AT1/AT2: transfer hands the ticket over and preserves the booking identity", async () => {
+    const { event } = await makeEvent({ capacity: 5 });
+    const created = await buy(alice.token, event.id);
+    const booking = created.body.data;
+    assert.ok(booking?.id, `purchase failed: ${JSON.stringify(created.body)}`);
+
+    const res = await api("POST", `/api/bookings/${booking.id}/transfer`, {
+      token: alice.token,
+      body: { recipientEmail: bob.email },
+    });
+    assert.equal(res.status, 200, JSON.stringify(res.body));
+
+    const after = await prisma.booking.findUnique({ where: { id: booking.id } });
+    assert.equal(after!.userId, bob.id, "recipient should now own the booking");
+    assert.equal(after!.status, "CONFIRMED", "status must stay CONFIRMED, not CANCELLED");
+    assert.equal(after!.ticketCode, booking.ticketCode, "ticket code must be preserved");
+    assert.equal(after!.qrCodeData, booking.qrCodeData, "QR payload must be preserved");
+    assert.equal(after!.cancelledAt, null, "transfer must not stamp cancelledAt");
+  });
+
+  await test("AT2: the ticket leaves the sender's bookings entirely (no cancelled ghost row)", async () => {
+    const { event } = await makeEvent({ capacity: 5 });
+    const created = await buy(alice.token, event.id);
+    const id = created.body.data.id;
+
+    await api("POST", `/api/bookings/${id}/transfer`, {
+      token: alice.token,
+      body: { recipientEmail: bob.email },
+    });
+
+    const mine = await api("GET", "/api/bookings", { token: alice.token });
+    const rows = mine.body.data.filter((b: any) => b.eventId === event.id);
+    assert.equal(rows.length, 0, `sender still sees ${rows.length} row(s): ${JSON.stringify(rows.map((r: any) => r.status))}`);
+  });
+
+  await test("AT3: the recipient sees the transferred ticket in their bookings", async () => {
+    const { event } = await makeEvent({ capacity: 5 });
+    const created = await buy(alice.token, event.id);
+    await api("POST", `/api/bookings/${created.body.data.id}/transfer`, {
+      token: alice.token,
+      body: { recipientEmail: bob.email },
+    });
+
+    const theirs = await api("GET", "/api/bookings", { token: bob.token });
+    const row = theirs.body.data.find((b: any) => b.eventId === event.id);
+    assert.ok(row, "recipient cannot see the ticket");
+    assert.equal(row.status, "CONFIRMED");
+  });
+
+  await test("AT6: the recipient can fetch a valid QR code for check-in", async () => {
+    const { event } = await makeEvent({ capacity: 5 });
+    const created = await buy(alice.token, event.id);
+    const id = created.body.data.id;
+    await api("POST", `/api/bookings/${id}/transfer`, {
+      token: alice.token,
+      body: { recipientEmail: bob.email },
+    });
+
+    const qr = await api("GET", `/api/bookings/${id}/qr`, { token: bob.token });
+    assert.equal(qr.status, 200, JSON.stringify(qr.body));
+    assert.match(qr.body.data.qrCode, /^data:image\/png;base64,/, "should return a PNG data URL");
+
+    // And the scanner accepts it.
+    const booking = await prisma.booking.findUnique({ where: { id } });
+    const scan = await api("POST", "/api/checkin", {
+      apiKey: CHECKIN_KEY,
+      body: { qrCode: booking!.qrCodeData },
+    });
+    assert.equal(scan.status, 200, `scanner rejected a transferred ticket: ${JSON.stringify(scan.body)}`);
+  });
+
+  await test("AT4: transferring to an unregistered email is rejected", async () => {
+    const { event } = await makeEvent({ capacity: 5 });
+    const created = await buy(alice.token, event.id);
+    const res = await api("POST", `/api/bookings/${created.body.data.id}/transfer`, {
+      token: alice.token,
+      body: { recipientEmail: `nobody-${RUN}@example.test` },
+    });
+    assert.equal(res.status, 404, JSON.stringify(res.body));
+    assert.match(res.body.message, /no registered user/i);
+  });
+
+  await test("AT5: transferring a cancelled booking is rejected", async () => {
+    const { event } = await makeEvent({ capacity: 5 });
+    const created = await buy(alice.token, event.id);
+    const id = created.body.data.id;
